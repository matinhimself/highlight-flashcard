{
  "manifest_version": 3,
  "name": "Lexis - AI Flashcards",
  "version": "1.0.0",
  "description": "Create AI-powered flashcards from highlighted text. Learn smarter with Lexis.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "ui/settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
